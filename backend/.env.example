APP_ENV=development
LOG_LEVEL=INFO

# --- Provider switches: this is the whole point of the architecture ---
# mock -> real swap requires ONLY changing these values.
STT_PROVIDER=mock
LLM_PROVIDER=mock
VECTOR_PROVIDER=qdrant
DATASET_PROVIDER=synthetic

# --- Sarvam STT (only needed when STT_PROVIDER=sarvam) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_PATH=/speech-to-text
SARVAM_STT_MODEL=saarika:v2

# --- Real LLM (only needed when LLM_PROVIDER=real; OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_JSON_MODE=true

# --- MSMARCO-XI dataset (only needed when DATASET_PROVIDER=msmarco_xi) ---
DATASET_LANGUAGE=hi
MSMARCO_SPLIT=validation
MSMARCO_MAX_DOCS=500

# --- Vector DB ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=voice_rag_chunks
QDRANT_LOCAL_PATH=./data/qdrant_local

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
ALLOW_HASHING_EMBEDDER_FALLBACK=true

# --- Indexing ---
CHUNKING_STRATEGY=sentence
PROCESSED_CHUNKS_FILE=./data/processed/chunks.jsonl
AUTO_INDEX_ON_STARTUP=true

# --- Retrieval ---
TOP_K_DENSE=20
TOP_K_BM25=20
TOP_K_RERANK=5
DENSE_WEIGHT=0.65
BM25_WEIGHT=0.35
RRF_K=60

# --- Guardrails ---
RETRIEVAL_CONFIDENCE_THRESHOLD=0.15
GROUNDING_THRESHOLD=0.5
OFF_TOPIC_MIN_VOCAB_HITS=1

# --- Reranker ---
# cross_encoder = higher-quality local CrossEncoder (~22M params, more RAM)
# lexical = lightweight CPU/RAM-friendly token-overlap scorer (Render Free friendly)
RERANKER_TYPE=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Timeouts (seconds) ---
STT_TIMEOUT_S=10.0
LLM_TIMEOUT_S=20.0
RETRIEVAL_TIMEOUT_S=5.0

DATA_DIR=./data

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
